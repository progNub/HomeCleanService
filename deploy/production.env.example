# Copy to project-root .env on the server (chmod 600). Supply every blank value.
DJANGO_SETTINGS_MODULE=settings.production
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=homecleanservice.by,www.homecleanservice.by,localhost,127.0.0.1
SITE_URL=https://homecleanservice.by
CSRF_TRUSTED_ORIGINS=https://homecleanservice.by,https://www.homecleanservice.by
DB_NAME=homeservice
DB_USER=homeservice_user
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
# Trust only the Nginx network; configure the exact Docker network CIDR.
TRUSTED_PROXY_CIDRS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_LOGS_CHAT_ID=
TELEGRAM_NOTIFICATIONS_CHAT_ID=
UMAMI_APP_SECRET=
CERTBOT_EMAIL=
CERTBOT_DOMAINS=homecleanservice.by,www.homecleanservice.by,stats.homecleanservice.by,logs.homecleanservice.by
# Required by image-based deployments: ghcr.io/owner/repo@sha256:...
APP_IMAGE=
# Scheduled backups require encryption and an off-host destination.
BACKUP_GPG_RECIPIENT=
BACKUP_REMOTE_DIR=
